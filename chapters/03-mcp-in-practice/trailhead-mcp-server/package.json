{
  "name": "trailhead-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trailhead's backend MCP server (Chapter 3)",
  "scripts": {
    "start": "node src/stdio.js",
    "start:http": "node src/http.js",
    "ask": "node src/client.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/stdio.js",
    "test": "node --test --test-concurrency=1 tests/trailhead.test.mjs",
    "check": "node --check src/catalog.js && node --check src/tools.js && node --check src/context.js && node --check src/server.js && node --check src/stdio.js && node --check src/http.js && node --check src/client.js && bash -n scripts/inspect.sh",
    "check:listings": "node tests/check-listings.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.11.0"
  }
}
