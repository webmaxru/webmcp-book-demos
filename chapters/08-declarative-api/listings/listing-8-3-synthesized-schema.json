{
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date (Dates MUST be provided in 'YYYY-MM-DD' format.)"
    },
    "time": {
      "type": "string",
      "format": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Preferred time, 24h HH:MM. Leave out for any time."
    },
    "partySize": {
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "multipleOf": 1,
      "description": "Guests"
    },
    "seating": {
      "type": "string",
      "anyOf": [
        {
          "type": "string",
          "const": "",
          "title": "No preference"
        },
        {
          "type": "string",
          "const": "window",
          "title": "By the window"
        },
        {
          "type": "string",
          "const": "indoor",
          "title": "Indoor"
        },
        {
          "type": "string",
          "const": "terrace",
          "title": "On the terrace"
        }
      ],
      "enum": [
        "",
        "window",
        "indoor",
        "terrace"
      ],
      "description": "Seating"
    }
  },
  "required": [
    "date",
    "partySize"
  ]
}
